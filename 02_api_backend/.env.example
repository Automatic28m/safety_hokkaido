GROQ_API_KEY=
METEOSOURCE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Comma-separated list of origins allowed to call this API via CORS.
# "*" is always stripped out. Defaults to http://localhost:3000 if unset.
ALLOWED_ORIGINS=

# Set to "true" to enable debug-only endpoints (currently /reset_memory).
# Leave unset/"false" in shared environments: global_memory is shared across all users.
ENABLE_DEBUG_ENDPOINTS=
